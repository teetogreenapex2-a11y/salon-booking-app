generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth) models ---------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  business      Business?

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models -----------------------------------------------------------

model Business {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String?
  logoUrl      String?
  address      String?
  instagram    String?
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  trialEndsAt          DateTime?

  stripeConnectedAccountId String?  @unique
  stripeChargesEnabled     Boolean  @default(false)
  noShowFeeCents           Int      @default(2500)

  ownerId      String?  @unique
  owner        User?    @relation(fields: [ownerId], references: [id])

  stylists     Stylist[]
  services     Service[]
  bookings     Booking[]
  customers    Customer[]
  photos       Photo[]
}

model Stylist {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  specialty   String?
  photoUrl    String?
  active      Boolean  @default(true)

  // The email a stylist signs in with (set by the owner on the Stylists
  // page). Not a foreign key to User — it's just matched against the
  // signed-in email at request time (see getCurrentStylist in lib/auth.ts)
  // so access can be granted before that person has ever signed in once.
  email       String?  @unique

  googleRefreshToken  String?
  outlookRefreshToken String?

  // Booth-renter support — both default to false (everyone stays exactly
  // as they work today unless the owner flips one of these on).
  //
  // independentPayouts: when true, this stylist's own card-on-file charges
  // (no-show fees, deposits) land in THEIR Stripe account instead of the
  // salon owner's. Needs its own Connect onboarding below.
  independentPayouts        Boolean  @default(false)
  stripeConnectedAccountId  String?  @unique
  stripeChargesEnabled      Boolean  @default(false)

  // independentBilling: when true, this stylist pays Hairsalonix directly
  // for their own seat and is excluded from the salon's per-stylist add-on
  // count (see addOnQuantityFor in lib/stripe.ts). Independent of the
  // payouts toggle above — a stylist can have either, both, or neither.
  independentBilling   Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?

  bookings    Booking[]
  availability Availability[]
  preferredByCustomers Customer[] @relation("PreferredStylist")
  serviceOverrides StylistService[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  durationMin Int
  priceCents  Int
  tag         String?
  active      Boolean  @default(true)

  bookings    Booking[]
  stylistOverrides StylistService[]
}

// Optional per-stylist override of a shared service's price and/or
// duration (e.g. Stylist A does a cut/color in 2 hours at $90, Stylist B
// takes 3 hours at $120 for the same Service row). Either field can be
// left null to fall back to the base Service's value — a row only needs
// to exist at all once a stylist has at least one override set.
model StylistService {
  id          String   @id @default(cuid())
  stylistId   String
  stylist     Stylist  @relation(fields: [stylistId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  priceCents  Int?
  durationMin Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([stylistId, serviceId])
}

model Availability {
  id         String  @id @default(cuid())
  stylistId  String
  stylist    Stylist @relation(fields: [stylistId], references: [id])
  dayOfWeek  Int
  startMin   Int
  endMin     Int
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  email       String
  phone       String?

  stripeCustomerId      String?
  stripePaymentMethodId String?

  notes               String?
  allergies           String?
  preferredStylistId  String?
  preferredStylist    Stylist? @relation("PreferredStylist", fields: [preferredStylistId], references: [id])
  noShowCount         Int      @default(0)

  bookings    Booking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, email])
}

model Photo {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Booking {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  stylistId    String
  stylist      Stylist  @relation(fields: [stylistId], references: [id])
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String?

  startsAt     DateTime
  endsAt       DateTime
  status       BookingStatus @default(CONFIRMED)

  priceCents   Int           @default(0)

  stripePaymentIntentId String?

  noShowFeeChargedAt DateTime?

  reminderSentAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
