generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth) models ---------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  business      Business?

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models -----------------------------------------------------------

model Business {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String?
  logoUrl      String?
  // Optional per-salon branding: a hex accent color (e.g. #7f2d4a) and a
  // cover photo shown at the top of the public booking page.
  accentColor  String?
  coverUrl     String?
  address      String?
  instagram    String?
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  trialEndsAt          DateTime?

  // Answers to the owner's first-visit setup questionnaire (see
  // lib/setup.ts). Null until they answer or skip; used only to tailor
  // the "Get set up" checklist.
  setupAnswers Json?

  stripeConnectedAccountId String?  @unique
  stripeChargesEnabled     Boolean  @default(false)
  noShowFeeCents           Int      @default(2500)
  // Customers can reschedule/cancel themselves up to this many hours
  // before the appointment; closer than that they're told to contact the salon.
  cancelCutoffHours        Int      @default(24)

  ownerId      String?  @unique
  owner        User?    @relation(fields: [ownerId], references: [id])

  // People with full owner access besides the account owner (ownerId).
  // See BusinessMember below.
  members      BusinessMember[]

  stylists     Stylist[]
  services     Service[]
  bookings     Booking[]
  customers    Customer[]
  photos       Photo[]
  products     Product[]
  sales        Sale[]
}

model Stylist {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  specialty   String?
  photoUrl    String?
  active      Boolean  @default(true)

  // The email a stylist signs in with (set by the owner on the Stylists
  // page). Not a foreign key to User — it's just matched against the
  // signed-in email at request time (see getCurrentStylist in lib/auth.ts)
  // so access can be granted before that person has ever signed in once.
  email       String?  @unique

  googleRefreshToken  String?
  outlookRefreshToken String?

  // Owner-controlled permissions — both default to true so nothing
  // changes for anyone until the owner deliberately turns one off on the
  // Stylists page.
  canEditOwnPricing Boolean @default(true)
  canEditOwnHours   Boolean @default(true)
  // Off by default: lets a stylist add new services to the shared menu.
  canAddServices    Boolean @default(false)

  // Commission this stylist earns on retail product sales they ring up
  // (0-100). Defaults to 0 — no commission — until the owner sets one.
  // Snapshotted onto Sale.commissionCents at sale time so a later change
  // here never rewrites the history of past sales.
  retailCommissionPct Int @default(0)

  // Optional "pay outside the app" handles. Display/link only — Hairsalonix
  // never touches this money. Stored without the leading @ or $.
  venmoHandle   String?
  cashAppHandle String?
  zelleInfo     String?

  // Booth-renter support — both default to false (everyone stays exactly
  // as they work today unless the owner flips one of these on).
  //
  // independentPayouts: when true, this stylist's own card-on-file charges
  // (no-show fees, deposits) land in THEIR Stripe account instead of the
  // salon owner's. Needs its own Connect onboarding below.
  independentPayouts        Boolean  @default(false)
  stripeConnectedAccountId  String?  @unique
  stripeChargesEnabled      Boolean  @default(false)

  // independentBilling: when true, this stylist pays Hairsalonix directly
  // for their own seat and is excluded from the salon's per-stylist add-on
  // count (see addOnQuantityFor in lib/stripe.ts). Independent of the
  // payouts toggle above — a stylist can have either, both, or neither.
  independentBilling   Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?

  bookings    Booking[]
  availability Availability[]
  preferredByCustomers Customer[] @relation("PreferredStylist")
  serviceOverrides StylistService[]
  sales       Sale[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  durationMin Int
  priceCents  Int
  tag         String?
  active      Boolean  @default(true)

  bookings    Booking[]
  stylistOverrides StylistService[]
}

// Optional per-stylist override of a shared service's price and/or
// duration (e.g. Stylist A does a cut/color in 2 hours at $90, Stylist B
// takes 3 hours at $120 for the same Service row). Either field can be
// left null to fall back to the base Service's value — a row only needs
// to exist at all once a stylist has at least one override set.
model StylistService {
  id          String   @id @default(cuid())
  stylistId   String
  stylist     Stylist  @relation(fields: [stylistId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  priceCents  Int?
  durationMin Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([stylistId, serviceId])
}

model Availability {
  id         String  @id @default(cuid())
  stylistId  String
  stylist    Stylist @relation(fields: [stylistId], references: [id])
  dayOfWeek  Int
  startMin   Int
  endMin     Int
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  email       String
  phone       String?

  // Deprecated — kept so old rows aren't lost, but no longer written to.
  // A customer's actual card(s) on file now live in CustomerCard below,
  // one row per Stripe connected account (a card saved under the salon's
  // account can't be charged from a booth renter's own account, or vice
  // versa — they're separate Stripe accounts). See CustomerCard's comment.
  stripeCustomerId      String?
  stripePaymentMethodId String?

  cards               CustomerCard[]

  notes               String?
  allergies           String?
  preferredStylistId  String?
  preferredStylist    Stylist? @relation("PreferredStylist", fields: [preferredStylistId], references: [id])
  noShowCount         Int      @default(0)

  bookings    Booking[]
  sales       Sale[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, email])
}

// A customer's saved card, scoped to ONE Stripe connected account.
// Whoever is being paid out — the salon, or a booth renter with their own
// independent payouts — has their own separate Stripe Connect account, and
// a card/customer object saved under one of those accounts can only ever
// be charged from that same account. So instead of one card per Customer,
// this is one card per (customer, connected account) pair — a customer
// who's booked with both the salon and a booth renter ends up with two
// rows here, one per account, and the right one gets picked at charge time
// by whichever account that particular booking's stylist pays out to (see
// resolvePayoutAccountId in lib/stripe.ts).
model CustomerCard {
  id                    String   @id @default(cuid())
  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id])
  connectedAccountId    String
  stripeCustomerId      String
  stripePaymentMethodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, connectedAccountId])
}

model Photo {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  priceCents  Int
  stockQty    Int      @default(0)
  active      Boolean  @default(true)

  saleItems   SaleItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A rung-up retail sale, always tied to whichever stylist did the
// checkout (so it can be credited to them in reports/payouts) and
// usually to the booking it happened at — see /api/admin/bookings/[id]/sell
// for how this gets created, stock decremented, and the card on file
// charged.
model Sale {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  bookingId   String?  @unique
  booking     Booking? @relation(fields: [bookingId], references: [id])
  stylistId   String
  stylist     Stylist  @relation(fields: [stylistId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  totalCents  Int

  // Snapshot of stylist.retailCommissionPct × totalCents at the moment of
  // sale — stored here (not recomputed later) so changing a stylist's
  // commission rate afterward never changes what a past sale shows they
  // earned.
  commissionCents Int @default(0)

  stripePaymentIntentId String?
  chargedAt             DateTime?

  items       SaleItem[]

  createdAt   DateTime @default(now())
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  priceCentsEach Int
}

model Booking {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  stylistId    String
  stylist      Stylist  @relation(fields: [stylistId], references: [id])
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String?
  smsConsent    Boolean  @default(false)
  // Secret in the customer's "change or cancel" link (/manage/<token>).
  manageToken   String?  @unique
  // The matching event on the stylist's Google Calendar, if synced.
  googleEventId String?

  startsAt     DateTime
  endsAt       DateTime
  status       BookingStatus @default(CONFIRMED)

  priceCents   Int           @default(0)

  stripePaymentIntentId String?

  noShowFeeChargedAt DateTime?

  // Set when the owner records that the customer paid outside the app
  // (Venmo, Cash App, Zelle, cash). A record only — no money moves here.
  paidOutsideAt     DateTime?
  paidOutsideMethod String?

  reminderSentAt DateTime?

  sale         Sale?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// A co-owner: someone who signs in with their own login and gets the same
// full owner access as the account owner, on the same business. Matched by
// email (like Stylist.email), so they can be invited before they've ever
// signed in. email is unique across the whole table so a person is a
// co-owner of at most one business, which keeps "which business is this
// login's?" unambiguous. The account owner (Business.ownerId) is NOT a row
// here — only the people added on top of them.
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  email      String   @unique
  role       String   @default("OWNER")
  createdAt  DateTime @default(now())

  @@index([businessId])
}
